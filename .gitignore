# ===== Build outputs =====
dist/
bin/
*.tar.gz

# ===== Toolchain / generated assets =====
internal/toolchain/assets/

# ===== Local dev / tooling =====
.claude/
.env
.DS_Store

# ===== Logs =====
*.log
/logs/
.cache/
*.tar.xz
# Anchored to repo root so it ignores the built binary, NOT the cmd/samo-server/
# source directory (a bare `samo-server` pattern matched that directory and hid
# its source files from git).
/samo-server
data/*.db
data/*.db-*
/samo-server-local
/quarantine/

# NOTE: migrations/ must NEVER be ignored. The SQL files are compiled into the
# binary by //go:embed in migrations/migrations.go, so an untracked migration
# is silently absent from every build made from a clean checkout — the schema
# it creates just never exists. 0008_playlist_tombstones.sql was lost that way.
