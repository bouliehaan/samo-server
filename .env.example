# Copy to .env and edit, or just run `./install.sh`. `docker compose` reads
# this automatically.

# --- Postgres -------------------------------------------------------------
# Password for the bundled Postgres container. Change it before first boot;
# it is baked into the database on the very first `up`.
POSTGRES_PASSWORD=changeme

# --- Media ----------------------------------------------------------------
# The host directory that holds your media. Must be an ABSOLUTE path. It is
# bind-mounted into the container at the SAME path, so absolute paths already in
# your database keep working after the move to Docker. Point the library
# variables below at subfolders of it.
SAMO_MEDIA_HOST_DIR=/mnt/media

# Library folders (inside the container = same as on the host). Separate
# multiple folders with a colon, e.g. /mnt/media/Music:/mnt/media/More.
SAMO_MUSIC_DIRS=/mnt/media/Music
SAMO_AUDIOBOOK_DIRS=/mnt/media/Audiobooks
SAMO_PODCAST_DIRS=/mnt/media/Podcasts

# --- First-run admin (optional) ------------------------------------------
# Leave both blank to create the admin through the web /setup wizard instead.
SAMO_BOOTSTRAP_USERNAME=
SAMO_BOOTSTRAP_PASSWORD=

# --- Integrations (optional) ---------------------------------------------
SAMO_LASTFM_API_KEY=
SAMO_LASTFM_SHARED_SECRET=
SAMO_ACOUSTID_API_KEY=

# --- Behavior (optional; these are the defaults) -------------------------
# SAMO_SCAN_ON_START=false
# SAMO_PODCAST_POLL=true
# SAMO_ADDR=:6969
