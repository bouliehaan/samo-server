[Unit]
Description=Samo Server — self-hosted music, audiobooks, podcasts, radio
Documentation=https://github.com/bouliehaan/samo-server
After=network-online.target
Wants=network-online.target
# Ordering only — no dependency. Local-Postgres installs get the right boot
# order; installs pointing SAMO_DB_DSN at Docker or another host are unaffected
# (systemd ignores ordering against a unit that isn't present).
After=postgresql.service

# Rate-limit restarts here, not in [Service]: systemd moved StartLimit* to the
# unit section in v229 and ignores it under [Service]. After 5 failures in 5
# minutes the unit stops and the failure stays visible in `systemctl status`
# instead of being buried in a hot restart loop.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=samo
Group=samo
WorkingDirectory=/var/lib/samo
ExecStart=/opt/samo/samo-server

# Restart=always, not on-failure: an appliance should come back from a clean
# exit too (an unhandled SIGPIPE, an operator's `kill`, a bug that returns
# rather than crashes). The [Unit] StartLimit* settings bound the retries.
Restart=always
RestartSec=5s

# Give in-flight streams and background workers time to unwind. The server's
# own drain is bounded well under this, so hitting it means something wedged.
TimeoutStopSec=45s

# Defaults. Override these by dropping a file in /etc/systemd/system/samo-server.service.d/
Environment=SAMO_DATA_DIR=/var/lib/samo
Environment=SAMO_ADDR=:6969
Environment=SAMO_SCAN_ON_START=false

# REQUIRED: the PostgreSQL connection string, e.g.
#   SAMO_DB_DSN=postgres://samo:password@localhost:5432/samo?sslmode=disable
# Put it (and any other secrets) in /etc/samo-server.env, mode 0600.
EnvironmentFile=-/etc/samo-server.env

# Light hardening. The operator can tighten this with a drop-in if their
# media folders aren't under common locations like /srv, /mnt, /media.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/samo
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Journal is the easiest path for log discovery on a stock Ubuntu box.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
